<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<UserSecretsId>maliev-inventoryservice-api</UserSecretsId>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Maliev.InventoryService.Domain\Maliev.InventoryService.Domain.csproj" />
		<ProjectReference Include="..\Maliev.InventoryService.Infrastructure\Maliev.InventoryService.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
		<ProjectReference Include="..\..\Maliev.Aspire\Maliev.Aspire.ServiceDefaults\Maliev.Aspire.ServiceDefaults.csproj" />
		<ProjectReference Include="..\..\Maliev.MessagingContracts\generated\csharp\Maliev.MessagingContracts.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<PackageReference Include="Maliev.Aspire.ServiceDefaults" Version="$(SharedLibraryVersion)" />
		<PackageReference Include="Maliev.MessagingContracts" Version="$(SharedLibraryVersion)" />
	</ItemGroup>

</Project>
